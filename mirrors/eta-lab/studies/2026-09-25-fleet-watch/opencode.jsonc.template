{
  "$schema": "https://opencode.ai/config.json",
  // fleet-watch (rulings 399 + 401): a SEPARATE config for this agent only (OPENCODE_CONFIG). Secrets only by {file:} reference. NO remote Scribe MCP and NO Scribe token reference here:
  // the agent gets the LOCAL stdio proxy "scribe-fleet", which alone reads the token and forwards only 4 allowlisted read tools (r402: NOT scribe_session_tape) (include_* refused, URLs/identity scrubbed).
  "provider": { "opencode": { "options": { "apiKey": "{file:/home/eta/.claude/secrets/opencode_zen_key}" } } },
  "mcp": {
    "scribe-fleet": { "type": "local", "command": ["python3", "/home/eta/fleet-watch/bin/scribe_fleet_mcp.py"], "enabled": true }
  },
  // ALLOWLIST: everything off, then exactly the proxy's read tools on.
  "tools": {
    "*": false,
    "scribe-fleet_scribe_rooms": true,
    "scribe-fleet_scribe_system": true,
    "scribe-fleet_scribe_health": true,
    "scribe-fleet_scribe_sessions": true
  },
  "permission": { "edit": "deny", "bash": "deny", "webfetch": "deny", "external_directory": "deny", "doom_loop": "deny" },
  "agent": {
    "title": { "disable": true },
    "fleet-watch": {
      "mode": "primary",
      "description": "read-only room-fleet gatherer",
      "prompt": "You gather facts about a fleet of recording rooms through the scribe-fleet tools. Call scribe-fleet_scribe_rooms with view=now, then scribe-fleet_scribe_health with no arguments. Investigate with the other scribe-fleet tools only if something looks unusual. Then answer with ONE strict JSON object and nothing else: {\"ts\": <ISO time>, \"rooms\": [{\"room\": <name>, \"state\": <room_state.state>, \"recording\": <bool>, \"last_piece_age_s\": <seconds since last_piece_at or null>, \"kiosk\": <listener_state>, \"issues\": [short strings]}], \"fleet_issues\": [short strings]}. Copy values, do not guess. Never ask for or repeat any text, name, link or identifier beyond what those fields need.",
      "tools": {
        "*": false,
        "scribe-fleet_scribe_rooms": true, "scribe-fleet_scribe_system": true, "scribe-fleet_scribe_health": true, "scribe-fleet_scribe_sessions": true
      }
    }
  }
}
