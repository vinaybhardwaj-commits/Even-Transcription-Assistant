#!/bin/zsh
# diarize-guard.sh — restarts uk.llmvinayminihome.eta-diarize (:8001) when its RSS footprint exceeds a
# threshold and no connection to its port has been open for 60s. Run every 10 min by launchd.
#
# WHY. The 21-22 Sep overnight run thrashed because eta-diarize leaked to 34 GB (22 GB compressed) since
# its 22:57 restart, filling swap to 39.2 of 39.9 GB; 35 of 39 gate holds that night were
# STOP_sustained_pressure, and median window wall time was 298 s. Fable restarted it and fixed it live at
# 06:37 IST 22 Sep; this guard is so the leak coming back does not need a person watching.
#
# WHY "no connection for 60s", not just over threshold: restarting mid-request would fail whatever window
# it was diarizing. Checking now AND again after a 60s sleep is cheap (this runs every 10 min) and simple,
# not a byte-perfect guarantee — a connection opening in between the two checks is still missed, and a
# fix for that is a job for the diarize service itself (a drain-before-restart), not this guard.
#
# scribe3, 22 Sep 2026 (Fable's order, 06:40).
THRESHOLD_GB="${1:-12}"
LOG="$HOME/overnight-translate/diarize-guard.log"
LABEL="uk.llmvinayminihome.eta-diarize"
PORT=8001
stamp() { date -u +%FT%TZ; }

PID=$(pgrep -f "eta-diarize/.venv/bin/uvicorn" | head -1)
if [ -z "$PID" ]; then
  echo "$(stamp) guard: no diarize process found (label $LABEL), nothing to check" >> "$LOG"
  exit 0
fi

RSS_KB=$(ps -o rss= -p "$PID" 2>/dev/null | tr -d ' ')
if [ -z "$RSS_KB" ]; then
  echo "$(stamp) guard: pid $PID vanished mid-check, nothing to do" >> "$LOG"
  exit 0
fi
RSS_GB=$(awk -v kb="$RSS_KB" 'BEGIN { printf "%.2f", kb/1024/1024 }')
OVER=$(awk -v r="$RSS_GB" -v t="$THRESHOLD_GB" 'BEGIN { print (r >= t) ? "1" : "0" }')

if [ "$OVER" != "1" ]; then
  echo "$(stamp) guard: diarize pid $PID RSS ${RSS_GB}GB under threshold ${THRESHOLD_GB}GB, ok" >> "$LOG"
  exit 0
fi

# Over threshold. Never restart mid-request: check for an open connection now, and again after 60s.
open_conn() { lsof -nP -iTCP:$PORT -sTCP:ESTABLISHED 2>/dev/null | grep -c ESTABLISHED; }
C1=$(open_conn)
if [ "$C1" != "0" ]; then
  echo "$(stamp) guard: diarize pid $PID RSS ${RSS_GB}GB over ${THRESHOLD_GB}GB but $C1 connection(s) open, not restarting" >> "$LOG"
  exit 0
fi
sleep 60
C2=$(open_conn)
if [ "$C2" != "0" ]; then
  echo "$(stamp) guard: diarize pid $PID RSS ${RSS_GB}GB over ${THRESHOLD_GB}GB but a connection opened during the 60s wait, not restarting" >> "$LOG"
  exit 0
fi

launchctl kickstart -k "gui/$(id -u)/$LABEL" 2>>"$LOG"
echo "$(stamp) guard: RESTARTED $LABEL — pid was $PID, RSS ${RSS_GB}GB (threshold ${THRESHOLD_GB}GB), no connection for 60s" >> "$LOG"
