+# --- MPS memory-leak guard (22 Sep 2026 RCA: ~/dev/_fable/scratch/diarize-leak-rca.md) ---
+# torch's MPS backend grows driver memory whenever a model sees a batch shape it has not seen at
+# that moment: nn.LSTM (pyannote segmentation, used by diarization AND OSD) leaks on EVERY shape
+# change and torch.mps.empty_cache() does not return it; the embedding ResNet caches one pool per
+# batch size. pyannote feeds full batches of 32, then a partial batch, then a 1-chunk orphan, so
+# every request changes shape several times. Padding every batch to its fixed size means the models
+# only ever see one shape. Padded rows are dropped; outputs are byte-identical (tested).
+from pyannote.audio.core.inference import Inference as _PyaInference
+from pyannote.audio.pipelines.speaker_verification import (
+    PyannoteAudioPretrainedSpeakerEmbedding as _PyaEmbedding,
+)
+
+_orig_infer = _PyaInference.infer
+_orig_embed = _PyaEmbedding.__call__
+_EMB_BS = diarize_pipeline.embedding_batch_size
+
+
+def _fixed_shape_infer(self, chunks):
+    n = chunks.shape[0]
+    if self.device.type != "mps" or n >= self.batch_size:
+        return _orig_infer(self, chunks)
+    pad = chunks.new_zeros((self.batch_size - n,) + tuple(chunks.shape[1:]))
+    out = _orig_infer(self, torch.cat([chunks, pad]))
+    return tuple(o[:n] for o in out) if isinstance(out, tuple) else out[:n]
+
+
+def _fixed_shape_embed(self, waveforms, masks=None):
+    n = waveforms.shape[0]
+    if self.device.type != "mps" or n >= _EMB_BS:
+        return _orig_embed(self, waveforms, masks)
+    waveforms = torch.cat([waveforms, waveforms.new_zeros((_EMB_BS - n,) + tuple(waveforms.shape[1:]))])
+    if masks is not None:
+        masks = torch.cat([masks, masks.new_ones((_EMB_BS - n,) + tuple(masks.shape[1:]))])
+    return _orig_embed(self, waveforms, masks)[:n]
+
+
+_PyaInference.infer = _fixed_shape_infer
+_PyaEmbedding.__call__ = _fixed_shape_embed
+
 print("[startup] models loaded. ready.")
 
