{
  // Read-only transcript viewer (ruling 184 part B). Behind Cloudflare Access on a custom domain ONLY.
  // workers_dev/preview_urls are off so the Worker has no unprotected *.workers.dev address.
  // The custom-domain route was added ONLY after tunnel-ops confirmed the Access app exists (see README.md).
  "name": "eta-lab-viewer",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  // Attached only after tunnel-ops confirmed the Access app (ruling 208, 24 Sep 20:00 IST).
  "routes": [{ "pattern": "lab.llmvinayminihome.uk", "custom_domain": true }],
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "RESULTS", "bucket_name": "eta-lab-results" },
    { "binding": "AUDIO", "bucket_name": "eta-audio" },
    { "binding": "RATINGS", "bucket_name": "eta-lab-ratings" }
  ]
  // secrets: ACCESS_AUD (app AUD tag), ACCESS_TEAM_DOMAIN (gentle-union-75e6.cloudflareaccess.com), ALLOWED_EMAILS (comma list)
}
