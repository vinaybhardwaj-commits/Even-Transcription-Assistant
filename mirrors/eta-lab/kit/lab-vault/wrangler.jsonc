{
  // Write-once ingest door for the eta-lab-results vault (ruling 184). NOT the production audio-join Worker.
  "name": "eta-lab-ingest",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-20",
  "observability": { "enabled": true },
  "r2_buckets": [{ "binding": "RESULTS", "bucket_name": "eta-lab-results" }]
  // secret INGEST_TOKEN: wrangler secret put INGEST_TOKEN < ~/.claude/secrets/lab_ingest
}
