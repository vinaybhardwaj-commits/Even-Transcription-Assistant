[Unit]
Description=Refresh the viewer's Days index (index/view-<stamp>.jsonl) and push it; writes nothing when nothing changed

[Service]
Type=oneshot
ExecStart=%h/.local/share/lab-vault/venv/bin/python %h/.local/share/lab-vault/build-index.py --view-only
# a new view file is pushed right away; exit 1 from the push (files pending/rejected) is normal
ExecStartPost=-/usr/bin/python3 %h/.local/share/lab-vault/vault-push.py --scan
SuccessExitStatus=0 1
