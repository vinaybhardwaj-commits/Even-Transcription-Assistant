# lab sshd (herdr-kit, Fable ruling 129, 24 Sep 2026): user-mode, no sudo, loopback only.
# WHY: the Mini's system sshd is launchd inetd-style with Instances=42 (SIP-protected plist); box panes hold ~38 MCP ssh
# sessions, so new connections are accepted and closed at the cap. This sshd has no such cap. The system sshd and its
# 2222 reverse forward are NOT touched; old sessions drain as panes restart.
Port 2223
ListenAddress 127.0.0.1
HostKey $HOME/.ssh/lab-sshd/ssh_host_ed25519_key
PidFile $HOME/.ssh/lab-sshd/sshd.pid
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
PubkeyAuthentication yes
PermitRootLogin no
AllowUsers vinaybhardwaj
MaxStartups 100:30:200
MaxSessions 64
AuthorizedKeysFile .ssh/authorized_keys
LogLevel INFO
