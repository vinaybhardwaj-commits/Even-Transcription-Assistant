# Proposed /etc/systemd/system/nemotron-diarize-twin.service (lab-mover owns the box units; install with sudo, then `systemctl enable --now`).
# Currently running under setsid/nohup as user eta (no reboot survival). Localhost only; needs eta-diarize-twin.service (:8001) for ECAPA.
[Unit]
Description=Nemotron-3-Diarization behind the /diarize contract (box T4, localhost :8002)
After=network-online.target eta-diarize-twin.service

[Service]
Type=simple
User=eta
WorkingDirectory=/home/eta/services/nemotron-diarize
Environment=HF_HOME=/home/eta/.cache/huggingface
ExecStart=/home/eta/eta-data/nemotron/venv-nemo-main/bin/uvicorn server:app --host 127.0.0.1 --port 8002
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
