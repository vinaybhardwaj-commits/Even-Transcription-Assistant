# Names only. Copy to ~/.config/newcat/worker.env, chmod 600, fill in on the host. Never commit values.
# Plain KEY=value lines, no quotes, no export (read by systemd EnvironmentFile and docker --env-file).

# --- host paths for the read-only mounts (read by the unit; any existing directory) ---
NEWCAT_HOST_LAB_DIR=
NEWCAT_HOST_REB_ROOT=
NEWCAT_HOST_SSH_DIR=

# --- reader source ---
NEWCAT_REB_SOURCE=
NEWCAT_REB_SSH_HOST=
NEWCAT_REB_SSH_LAB_DIR=
NEWCAT_REB_SSH_ROOT=
NEWCAT_HEARTBEAT_S=
WORKER_POLL_MS=

# --- core (docs/DEPLOY.md table) ---
NEWCAT_ENV=
DATABASE_URL=
CRON_SECRET=
WEBHOOK_SIGNING_SECRET=
NEWCAT_LLM=
NEWCAT_JEV=
NEWCAT_EMBED=
NEWCAT_GEMINI=
BEDROCK_REGION=
BEDROCK_MODEL_HAIKU=
BEDROCK_MODEL_SONNET=
BEDROCK_MODEL_OPUS=
BEDROCK_AUTH=
GCP_SA_KEY_JSON=
GCP_AUDIENCE=
