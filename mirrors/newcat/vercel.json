{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "regions": ["bom1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "migrations/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api?__p=/$1" }
  ]
}
