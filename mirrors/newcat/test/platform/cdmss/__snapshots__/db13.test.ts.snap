// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`db13 recipe SQL (INFERRED until validated live) > snapshots every recipe string 1`] = `
{
  "byUid": "SELECT ip.uid, ip.consult_uid, ip.doctor_uid, ip.kx_encounter_id, ip.type_of_prescription, ip.consult_type, ip.consult_types, ip.timestamp, ip._create_time, ip.prescription_url, ip.medications, ip.diagnosis_icd_codes, ip.impression_icd_codes, ip.general_advice, ip.further_investigation, ip.general_practitioner_prescription__presenting_complaints, ip.general_practitioner_prescription__plan_of_management, ip.general_practitioner_prescription__examination, ip.followup__followup_type, ip.followup__followup_date, ip.follow_up_type, ip.next_follow_up_date, ip.expected_resolution_date, ip.reason_for_consultation, ip.relevant_medical_history, ip.comorbidities, ip.refer_to, ip.num_referrals, d.presenting_complaint AS dpipe_pc, d.diagnosis AS dpipe_dx, d.plan_of_management AS dpipe_pom, d.further_investigation AS dpipe_inv FROM "individuals-prescriptions" ip LEFT JOIN (SELECT DISTINCT ON (presc_uid) presc_uid, presenting_complaint, diagnosis, plan_of_management, further_investigation FROM dpipe_prescription_pipeline WHERE presc_uid = 'rx-synth-0001' ORDER BY presc_uid, _update_time DESC) d ON d.presc_uid = ip.uid WHERE ip.uid = 'rx-synth-0001' LIMIT 1",
  "byUids": "SELECT ip.uid, ip.consult_uid, ip.doctor_uid, ip.kx_encounter_id, ip.type_of_prescription, ip.consult_type, ip.consult_types, ip.timestamp, ip._create_time, ip.prescription_url, ip.medications, ip.diagnosis_icd_codes, ip.impression_icd_codes, ip.general_advice, ip.further_investigation, ip.general_practitioner_prescription__presenting_complaints, ip.general_practitioner_prescription__plan_of_management, ip.general_practitioner_prescription__examination, ip.followup__followup_type, ip.followup__followup_date, ip.follow_up_type, ip.next_follow_up_date, ip.expected_resolution_date, ip.reason_for_consultation, ip.relevant_medical_history, ip.comorbidities, ip.refer_to, ip.num_referrals, d.presenting_complaint AS dpipe_pc, d.diagnosis AS dpipe_dx, d.plan_of_management AS dpipe_pom, d.further_investigation AS dpipe_inv FROM "individuals-prescriptions" ip LEFT JOIN (SELECT DISTINCT ON (presc_uid) presc_uid, presenting_complaint, diagnosis, plan_of_management, further_investigation FROM dpipe_prescription_pipeline WHERE presc_uid IN ('rx-synth-0001', 'rx-synth-0002') ORDER BY presc_uid, _update_time DESC) d ON d.presc_uid = ip.uid WHERE ip.uid IN ('rx-synth-0001', 'rx-synth-0002')",
  "comorbidities": "SELECT replace(p._parent_path, '/individuals/', '') AS individual_uid,
              p._doc_id, p.uploaded_at::text AS at, p.comorbidities::text AS comorbidities
         FROM "individuals-prescriptions" p
        WHERE p._parent_path IN ('/individuals/ind-synth-0001')
          AND p.is_draft = false
          AND p.comorbidities IS NOT NULL
          AND length(p.comorbidities::text) > 4
        ORDER BY p.uploaded_at ASC
        LIMIT 500",
  "count": "SELECT count(DISTINCT ip.uid)::int AS n FROM "individuals-prescriptions" ip WHERE ip.is_draft = false AND ip.type_of_prescription IN ('GENERAL_PRACTITIONER', 'HOSPITAL_GP', 'HOSPITAL_GYNAECOLOGY_ASSESSMENT', 'HOSPITAL_PAEDIATRIC', 'HOSPITAL_GYNAECOLOGY_OBSTETRICS', 'HOSPITAL_GP_INVESTIGATION_REFERRAL') AND (ip.timestamp AT TIME ZONE 'Asia/Kolkata')::date = '2026-10-01' AND ip.doctor_uid NOT IN ('dr-house-0001') AND (ip.doctor_name_with_speciality IS NULL OR ip.doctor_name_with_speciality NOT LIKE 'Even Health(%')",
  "creatinine": "SELECT replace(pv._parent_path, '/individuals/', '') AS individual_uid,
              pv.name, pv.data_value, pv.data_unit, pv.result_date::text AS at
         FROM "individuals-parameter_digital_values__parameters" pv
        WHERE pv._parent_path IN ('/individuals/ind-synth-0001')
          AND pv.name ILIKE '%creatinine%'
          AND pv.name NOT ILIKE '%ratio%'
        ORDER BY pv.result_date ASC
        LIMIT 500",
  "discharge": "SELECT b.admission_date_time, b.discharge_date_time
FROM individuals i
JOIN kx_billing_records b ON b.uhid = i.kx_uhid
WHERE i._doc_id = 'ind-synth-0001' AND b.discharge_date_time IS NOT NULL
ORDER BY b.discharge_date_time DESC LIMIT 1",
  "doctorNames": "SELECT uid, name_with_prefix FROM doctors WHERE uid IN ('dr-synth-0001')",
  "forDay": "SELECT * FROM (SELECT DISTINCT ON (ip.uid) ip.uid, ip.consult_uid, ip.doctor_uid, ip.kx_encounter_id, ip.type_of_prescription, ip.consult_type, ip.consult_types, ip.timestamp, ip._create_time, ip.prescription_url, ip.medications, ip.diagnosis_icd_codes, ip.impression_icd_codes, ip.general_advice, ip.further_investigation, ip.general_practitioner_prescription__presenting_complaints, ip.general_practitioner_prescription__plan_of_management, ip.general_practitioner_prescription__examination, ip.followup__followup_type, ip.followup__followup_date, ip.follow_up_type, ip.next_follow_up_date, ip.expected_resolution_date, ip.reason_for_consultation, ip.relevant_medical_history, ip.comorbidities, ip.refer_to, ip.num_referrals, d.presenting_complaint AS dpipe_pc, d.diagnosis AS dpipe_dx, d.plan_of_management AS dpipe_pom, d.further_investigation AS dpipe_inv FROM "individuals-prescriptions" ip LEFT JOIN (SELECT DISTINCT ON (presc_uid) presc_uid, presenting_complaint, diagnosis, plan_of_management, further_investigation FROM dpipe_prescription_pipeline WHERE (timestamp AT TIME ZONE 'Asia/Kolkata')::date BETWEEN '2026-10-01'::date - 1 AND '2026-10-01'::date + 1 ORDER BY presc_uid, _update_time DESC) d ON d.presc_uid = ip.uid WHERE ip.is_draft = false AND ip.type_of_prescription IN ('GENERAL_PRACTITIONER', 'HOSPITAL_GP', 'HOSPITAL_GYNAECOLOGY_ASSESSMENT', 'HOSPITAL_PAEDIATRIC', 'HOSPITAL_GYNAECOLOGY_OBSTETRICS', 'HOSPITAL_GP_INVESTIGATION_REFERRAL') AND (ip.timestamp AT TIME ZONE 'Asia/Kolkata')::date = '2026-10-01' AND ip.uid NOT IN ('rx-synth-0001') AND ip.doctor_uid NOT IN ('dr-house-0001') AND (ip.doctor_name_with_speciality IS NULL OR ip.doctor_name_with_speciality NOT LIKE 'Even Health(%') ORDER BY ip.uid, ip._update_time DESC) t ORDER BY t."timestamp" ASC LIMIT 50",
  "hospitals": "SELECT _doc_id, name FROM even_hospitals LIMIT 100",
  "icd": "SELECT replace(p._parent_path, '/individuals/', '') AS individual_uid,
              p._doc_id, p.uploaded_at::text AS at,
              p.diagnosis_icd_codes::text AS dx, p.impression_icd_codes::text AS imp
         FROM "individuals-prescriptions" p
        WHERE p._parent_path IN ('/individuals/ind-synth-0001')
          AND p.is_draft = false
        ORDER BY p.uploaded_at ASC
        LIMIT 1000",
  "pacCovered": "
      SELECT sc._doc_id, sc.individual_uid, sc.procedure_name, sc.financial__procedure_name,
             sc.status, sc.clinical__urgency, sc.pac__status,
             sc.clinical__comorbidities::text AS comorbidities,
             sc.hospital_info__hospital_uid,
             sc.planned_surgery_date::date::text AS surgery_date,
             sc.created_at::text AS created_at, sc._update_time::text AS updated_at,
             i.kx_uhid, i.display_name, i.first_name, i.last_name, i.gender,
             date_part('year', age((NOW() AT TIME ZONE 'Asia/Kolkata')::date, i.dob::date))::int AS age_years
        FROM surgery_cases sc
        JOIN individuals i ON i._doc_id = sc.individual_uid
        WHERE sc.status <> 'CANCELLED'
          AND i.kx_uhid IS NOT NULL
          AND EXISTS (SELECT 1 FROM kx_clinical_template_pac_reports p WHERE p.uhid = i.kx_uhid)
        ORDER BY sc.planned_surgery_date DESC NULLS LAST, sc._doc_id ASC
        LIMIT 10",
  "pacReports": "SELECT uid, uhid, status, template_name, created_at::text AS created_at, note,
              component_json::text AS component_json
         FROM kx_clinical_template_pac_reports
        WHERE uhid IN ('UH/SYN-1') AND status = 'final'
        ORDER BY created_at ASC
        LIMIT 500",
  "specialities": "SELECT doctor_uid, doctor_name_with_speciality AS label, count(*)::int AS n
       FROM "individuals-prescriptions"
      WHERE doctor_uid IN ('dr-synth-0001') AND doctor_name_with_speciality IS NOT NULL
        AND timestamp >= now() - interval '90 days'
      GROUP BY doctor_uid, doctor_name_with_speciality",
  "surgeryCases": "SELECT individual_uid, procedure_name, NULLIF(surgery_type_uid,'') AS surgery_type_uid,
       NULLIF(prescription_uid,'') AS prescription_uid, planned_surgery_date, status, created_at
FROM surgery_cases
WHERE individual_uid = 'ind-synth-0001'
ORDER BY planned_surgery_date DESC NULLS LAST",
  "surgicalFlag": "SELECT dp.individual_uid, pm.requires_surgery_or_procedure, pm.surgery_or_procedure_recommendation, p.uploaded_at
FROM dpipe_prescription_pipeline__plan_of_management pm
JOIN dpipe_prescription_pipeline dp ON dp._id = pm._parent_id
JOIN "individuals-prescriptions" p ON p._doc_id = dp.presc_uid
WHERE dp.individual_uid = 'ind-synth-0001' AND pm.requires_surgery_or_procedure = true
ORDER BY p.uploaded_at DESC",
  "upcoming": "
      SELECT sc._doc_id, sc.individual_uid, sc.procedure_name, sc.financial__procedure_name,
             sc.status, sc.clinical__urgency, sc.pac__status,
             sc.clinical__comorbidities::text AS comorbidities,
             sc.hospital_info__hospital_uid,
             sc.planned_surgery_date::date::text AS surgery_date,
             sc.created_at::text AS created_at, sc._update_time::text AS updated_at,
             i.kx_uhid, i.display_name, i.first_name, i.last_name, i.gender,
             date_part('year', age((NOW() AT TIME ZONE 'Asia/Kolkata')::date, i.dob::date))::int AS age_years
        FROM surgery_cases sc
        JOIN individuals i ON i._doc_id = sc.individual_uid
        WHERE sc.planned_surgery_date >= (NOW() AT TIME ZONE 'Asia/Kolkata')::date
          AND sc.planned_surgery_date < (NOW() AT TIME ZONE 'Asia/Kolkata')::date + INTERVAL '30 days'
          AND sc.status <> 'CANCELLED'
        ORDER BY sc.planned_surgery_date ASC, sc._doc_id ASC
        LIMIT 500",
}
`;
