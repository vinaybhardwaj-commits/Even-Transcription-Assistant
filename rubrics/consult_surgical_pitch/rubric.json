{
  "id": "consult_surgical_pitch",
  "version": "1.0.0",
  "title": "Surgical pitch in a consult",
  "unit": "consult",
  "inputs": [
    "consult_span",
    "consult_text"
  ],
  "engine": "llm_zdr",
  "source": "consult-surgical-pitch@v0",
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "surgery_recommended"
    ],
    "properties": {
      "surgery_recommended": {
        "type": "boolean"
      },
      "recommendation_kind": {
        "enum": [
          "surgery",
          "investigation",
          "conservative",
          "referral",
          "no_surgery",
          "other"
        ]
      },
      "pitch_source": {
        "enum": [
          "own",
          "own_contingent",
          "outside_surgeon"
        ]
      },
      "pitch_balance": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "benefits_named",
          "risks_named",
          "alternatives_named",
          "timing_named"
        ],
        "properties": {
          "benefits_named": {
            "type": "boolean"
          },
          "risks_named": {
            "type": "boolean"
          },
          "alternatives_named": {
            "type": "boolean"
          },
          "timing_named": {
            "type": "boolean"
          }
        }
      },
      "doubts": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ],
          "properties": {
            "kind": {
              "enum": [
                "pain",
                "complication",
                "anaesthesia",
                "cost",
                "work_family_time",
                "second_opinion",
                "too_soon",
                "other"
              ]
            },
            "code": {
              "enum": [
                "answered",
                "partial",
                "unheard",
                "deferred_to_family"
              ]
            },
            "quote": {
              "type": "string",
              "maxLength": 300
            },
            "t_s": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      },
      "uptake_of_surgery": {
        "enum": [
          "accept",
          "hedge",
          "refuse",
          "question",
          "defer",
          "cost",
          "unheard"
        ]
      },
      "prompted_yes": {
        "type": "boolean"
      },
      "evidence": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "quote"
          ],
          "properties": {
            "item": {
              "enum": [
                "surgery_recommended",
                "pitch_source",
                "benefits_named",
                "risks_named",
                "alternatives_named",
                "timing_named",
                "doubt_code",
                "uptake_of_surgery"
              ]
            },
            "quote": {
              "type": "string",
              "maxLength": 300
            },
            "t_s": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "bench": {
    "location": "rubric/bench/consult_surgical_pitch/gold.jsonl",
    "metric": "field_accuracy",
    "threshold": 0.8
  },
  "status": "draft",
  "definition": {
    "object": "the surgery recommendation in a doctor-patient consultation: how it is pitched, how doubt is handled, how the patient takes it up",
    "extends": "consult_chair_affect: keeps its four axes, uptake codes and teach-back, and adds the three blocks below",
    "recommendation_kind": [
      "surgery",
      "investigation",
      "conservative",
      "referral",
      "no_surgery",
      "other"
    ],
    "pitch_source": [
      "own",
      "own_contingent",
      "outside_surgeon"
    ],
    "pitch_balance": {
      "unit": "the audible surgery pitch, if one exists",
      "fields": {
        "benefits_named": "bool",
        "risks_named": "bool",
        "alternatives_named": "bool (watchful waiting, medicines, a different procedure, another centre)",
        "timing_named": "urgent, elective or if-not-better; the doctor's own staging is not patient deferral"
      },
      "not": "a lecture score; an empty tape is unscorable, not unbalanced"
    },
    "doubt_objects": {
      "unit": "each named patient fear or pushback about the operation",
      "kinds": [
        "pain",
        "complication",
        "anaesthesia",
        "cost",
        "work or family time",
        "second opinion",
        "too soon"
      ],
      "codes": [
        "answered",
        "partial",
        "unheard",
        "deferred_to_family"
      ],
      "rule": "whether THAT fear got a reply, not whether the patient is calm; reassurance stays a separate axis"
    },
    "uptake_of_surgery": {
      "codes": [
        "accept",
        "hedge",
        "refuse",
        "question",
        "defer",
        "cost",
        "unheard"
      ],
      "rules": [
        "a prompted yes is still accept but flagged",
        "the family later is defer, not refuse"
      ]
    },
    "sampling": "a chart keyword is not a pitch: score the audible recommendation only; a local referral is still a pitch",
    "followthrough_v1": [
      "ot_booked",
      "waitlisted",
      "cancelled",
      "no_show",
      "never",
      "different_procedure"
    ],
    "not_for": [
      "stay outcome labels",
      "ranking a surgeon before follow-through is joined",
      "disease severity read as distress"
    ],
    "engine_note": "engine llm_zdr since v1.0.0; the typed questions mirror the booleans and code-like items for a later Jev run, which waits for its own bench (draft status, S7-1).",
    "bench_population": "Meet scouts and Whisper episodes of Meet teleconsultations; no room tape."
  },
  "prompt": "prompt.json",
  "questions": [
    {
      "id": "surgery_recommended",
      "text": "Does the doctor recommend an operation in this consultation (an audible recommendation, not a chart keyword)?",
      "choices": [
        "yes",
        "no"
      ]
    },
    {
      "id": "pitch_source",
      "text": "Whose pitch is it: the speaking doctor's own, their contingent plan, or an outside surgeon's?",
      "choices": [
        "own",
        "own_contingent",
        "outside_surgeon"
      ]
    },
    {
      "id": "benefits_named",
      "text": "Does the doctor name the benefits of the operation?",
      "choices": [
        "yes",
        "no"
      ]
    },
    {
      "id": "risks_named",
      "text": "Does the doctor name the risks of the operation?",
      "choices": [
        "yes",
        "no"
      ]
    },
    {
      "id": "alternatives_named",
      "text": "Does the doctor name alternatives (watchful waiting, medicines, another procedure, another centre)?",
      "choices": [
        "yes",
        "no"
      ]
    },
    {
      "id": "timing_named",
      "text": "Does the doctor name the timing (urgent, elective, if-not-better)?",
      "choices": [
        "yes",
        "no"
      ]
    },
    {
      "id": "doubt_code",
      "text": "For one patient doubt about the operation, did it get a reply?",
      "choices": [
        "answered",
        "partial",
        "unheard",
        "deferred_to_family"
      ]
    },
    {
      "id": "uptake_of_surgery",
      "text": "How does the patient take up the surgery recommendation?",
      "choices": [
        "accept",
        "hedge",
        "refuse",
        "question",
        "defer",
        "cost",
        "unheard"
      ]
    }
  ]
}
