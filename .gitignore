# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (DO NOT COMMIT)
.env*.local
.env.development.local
.env.test.local
.env.production.local
secrets.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tests/e2e/.auth/

# Room Bench PRD/mockup — local-only docs (public repo)
docs/room-bench/
docs/brain/


# Warehouse fixtures (fuse slice 3) — a REAL extract holds individual_uid and is never
# committed. The one synthetic fixture beside scripts/load-warehouse-fixture.ts is the
# exception: fake uids, and it is what tests/unit/warehouse-join.test.ts runs against.
fixtures/warehouse/*.json
!fixtures/warehouse/synthetic-19-aug.json
.env*

# Vendored service dependencies — services/*/node_modules is install output, never source.
# (One of these is a 134 MB workerd binary that GitHub refuses outright.)
services/*/node_modules/

# Swift build output. apps/room-recorder/.build is regenerated by `swift build` and holds hundreds of
# megabytes of object files and module caches; it is never source. Clearing it is also the standard
# response to the intermittent TestingMacros plugin fault (docs/handoff/ETA-E27-SWIFT-TEST-FAULT-16-SEP-2026.md),
# so it must never be something a checkout carries.
.build/

# Probe artifacts under the handoff bus. docs/handoff/ IS committed — it is the institutional memory of
# this build, and one `git clean -fdx` used to be enough to delete it. docs/handoff/scratch/ is the
# exception: json dumps, run logs, .txt captures and one-off test fragments produced while proving
# something. The FINDING goes in a dated document beside it; the dump that produced it does not.
# (Twenty scratch files committed before this rule stay tracked; this only stops new ones arriving.)
docs/handoff/scratch/

# IDENTITY-BEARING BY CONSTRUCTION — NEVER COMMITTED (E18 R42, 16 Sep 2026). This repository is PUBLIC, and
# repo content reaching a public remote includes its history, which no later redaction removes. These two
# documents are inventories of which clinician has how many voice samples: the list of clinicians IS the
# document, so redacting them destroys the thing they are for. They stay on the filesystem, where they are
# useful, and out of git. See docs/handoff/ETA-E29-ID-TOKENS-IN-PUBLIC-HISTORY-16-SEP-2026.md.
docs/handoff/ETA-E7-VOICE-HARVEST-INVENTORY-14-SEP-2026.md
docs/handoff/ETA-E7-VOICE-HARVEST-INVENTORY-CC-KICKOFF-14-SEP-2026.md
# The same treatment, for a different reason (R45): this copy carries one id-shaped token, and its ORIGINAL —
# docs/handoff/ETA-S1-FIX2-REPORT-14-SEP-2026.md, committed 14 Sep and already on the public remote — carries
# the same one. Redacting the copy would buy nothing and would imply a fix that is not one.
docs/handoff/ETA-S1-FIX2-REPORT-14-SEP-2026-SCRATCH-COPY.md
