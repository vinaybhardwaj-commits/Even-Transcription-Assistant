# Build output (binding build and the compile-gated test-hooks build)
.build/
.build-hooks/
.swiftpm/

# Fixtures stay out of git: they are generated by `conformance generate` (and `attest-encoder`).
fixtures/

# No audio of any kind enters the repository.
*.pcm
*.raw
*.wav
*.webm
*.opus
*.flac
*.mp3

# Python bytecode from the tools
__pycache__/
*.pyc
