# Warehouse fixtures (fuse slice 3) — a REAL extract holds individual_uid and is never
# committed. The one synthetic fixture beside scripts/load-warehouse-fixture.ts is the
# exception: fake uids, and it is what tests/unit/warehouse-join.test.ts runs against.
fixtures/warehouse/*.json
!fixtures/warehouse/synthetic-19-aug.json
.env*

