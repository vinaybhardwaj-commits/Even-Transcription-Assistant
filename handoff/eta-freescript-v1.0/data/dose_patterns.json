{
  "version": "1.0",
  "source": "ETA ruling R2 (fix round 2). Applied after NFKC to every gp_extraction string outside /medicines and every note line outside Medication.",
  "number": "(?:\\d+(?:\\.\\d+)?|\\d+/\\d+|half|one|two|three|four|five|six|seven|eight|nine|ten)",
  "patterns": [
    {
      "id": "amount_unit",
      "regex": "(?i)\\b{N}\\s*-?\\s*(?:mg|mcg|µg|ug|gm?|ml|iu|units?|tabs?|tablets?|caps?|capsules?|puffs?|drops?|sachets?)\\b(?!\\s*/)"
    },
    {
      "id": "frequency",
      "regex": "(?i)(?<![a-z.])(?:o\\.?d|b\\.?i?\\.?d|t\\.?i\\.?d|t\\.?d\\.?s|q\\.?i\\.?d|q\\.?d\\.?s|h\\.?s|q\\.?h\\.?s|s\\.?o\\.?s|p\\.?r\\.?n|stat)\\.?(?![a-z])|\\bq\\s?\\d{1,2}\\s?h(?:rs?|ourly)?\\b"
    },
    {
      "id": "regimen",
      "regex": "(?<![\\d/-])(?:\\d|\\d/\\d|½)\\s*-\\s*(?:\\d|\\d/\\d|½)\\s*-\\s*(?:\\d|\\d/\\d|½)(?:\\s*-\\s*(?:\\d|\\d/\\d|½))?(?![\\d/-])"
    },
    {
      "id": "times_days",
      "regex": "(?i)(?:\\bx|×)\\s*{N}\\s*(?:days?|d|weeks?|wks?|months?)\\b"
    },
    {
      "id": "for_days",
      "regex": "(?i)\\bfor\\s+{N}\\s+(?:days?|weeks?|months?)\\b",
      "history_exempt": true
    }
  ],
  "history_paths": "^/(presenting_complaints/(symptoms|diagnoses/\\d+/.*)|comorbidities/\\d+/.*|examination)$",
  "history_note": "'for N days' in symptoms, diagnoses, comorbidities and examination is illness history, not a regimen; every other pattern applies there too.",
  "order_verbs": [
    "take",
    "takes",
    "taking",
    "start",
    "started",
    "continue",
    "continued",
    "give",
    "given",
    "prescribe",
    "prescribed",
    "increase",
    "reduce",
    "decrease",
    "switch",
    "add",
    "apply",
    "use",
    "inhale",
    "inject",
    "restart",
    "resume",
    "stop",
    "avoid",
    "drink"
  ],
  "skip_words": [
    "the",
    "a",
    "an",
    "your",
    "his",
    "her",
    "their",
    "this",
    "that",
    "these",
    "those",
    "it",
    "them",
    "all",
    "any",
    "some",
    "more",
    "less",
    "at",
    "least",
    "plenty",
    "of",
    "to",
    "up",
    "on",
    "with",
    "for",
    "only",
    "same",
    "usual",
    "regular",
    "normal",
    "as",
    "and",
    "or",
    "daily",
    "now",
    "again",
    "also",
    "just",
    "both",
    "enough",
    "extra",
    "lots",
    "lot",
    "much",
    "many",
    "each",
    "every",
    "with",
    "from",
    "in",
    "by"
  ],
  "word_frequency_note": "Word frequencies ('twice daily', 'three times a day') are not dose patterns: lifestyle advice uses them ('steam twice a day'). An unknown drug name with a word frequency and no order verb is a residual limit."
}
