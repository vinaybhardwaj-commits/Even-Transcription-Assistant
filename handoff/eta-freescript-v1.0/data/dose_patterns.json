{
  "version": "1.0",
  "source": "ETA ruling R2 (fix round 2). Applied after NFKC to every gp_extraction string outside /medicines and every note line outside Medication.",
  "number": "(?:\\d+(?:\\.\\d+)?|\\d+/\\d+|(?:seventeen|thirteen|fourteen|eighteen|nineteen|thousand|fifteen|sixteen|seventy|hundred|quarter|ombattu|eleven|twelve|twenty|thirty|eighty|ninety|paanch|naalku|three|seven|eight|forty|fifty|sixty|chaar|panch|eradu|mooru|hattu|zero|four|five|nine|half|teen|char|chhe|saat|aath|ondu|aidu|aaru|entu|one|two|six|ten|nau|das|elu|ek|do)(?:[\\s-]+(?:and\\s+)?(?:seventeen|thirteen|fourteen|eighteen|nineteen|thousand|fifteen|sixteen|seventy|hundred|quarter|ombattu|eleven|twelve|twenty|thirty|eighty|ninety|paanch|naalku|three|seven|eight|forty|fifty|sixty|chaar|panch|eradu|mooru|hattu|zero|four|five|nine|half|teen|char|chhe|saat|aath|ondu|aidu|aaru|entu|one|two|six|ten|nau|das|elu|ek|do))*)",
  "patterns": [
    {
      "id": "amount_unit",
      "regex": "(?i)\\b{N}(?:\\s+(?:a|an))?\\s*-?\\s*(?:mg|mcg|µg|ug|gm?|grams?|milligrams?|micrograms?|ml|millilitres?|milliliters?|iu|units?|tabs?|tablets?|caps?|capsules?|puffs?|drops?|sachets?|teaspoons?|tsp|tablespoons?|spoonfuls?|goli|goliyan|maatre|boond|hani)\\b(?!\\s*/)"
    },
    {
      "id": "frequency",
      "regex": "(?i)(?<![a-z.])(?:o\\.?d|b\\.?i?\\.?d|t\\.?i\\.?d|t\\.?d\\.?s|q\\.?i\\.?d|q\\.?d\\.?s|h\\.?s|q\\.?h\\.?s|s\\.?o\\.?s|p\\.?r\\.?n|stat)\\.?(?![a-z])|\\bq\\s?\\d{1,2}\\s?h(?:rs?|ourly)?\\b"
    },
    {
      "id": "regimen",
      "regex": "(?<![\\d/-])(?:\\d|\\d/\\d|½)\\s*-\\s*(?:\\d|\\d/\\d|½)\\s*-\\s*(?:\\d|\\d/\\d|½)(?:\\s*-\\s*(?:\\d|\\d/\\d|½))?(?![\\d/-])"
    },
    {
      "id": "times_days",
      "regex": "(?i)(?:\\bx|×)\\s*{N}\\s*(?:days?|d|weeks?|wks?|months?)\\b"
    },
    {
      "id": "for_days",
      "regex": "(?i)\\bfor\\s+{N}\\s+(?:days?|weeks?|months?)\\b",
      "history_exempt": true
    }
  ],
  "history_paths": "^/(presenting_complaints/(symptoms|diagnoses/\\d+/.*)|comorbidities/\\d+/.*|examination)$",
  "history_note": "'for N days' in symptoms, diagnoses, comorbidities and examination is illness history, not a regimen; every other pattern applies there too.",
  "order_verbs": [
    "take",
    "takes",
    "taking",
    "start",
    "started",
    "continue",
    "continued",
    "give",
