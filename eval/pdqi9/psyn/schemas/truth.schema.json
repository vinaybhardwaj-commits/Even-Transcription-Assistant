          "reversal_chain": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "enum": [
                    "firm",
                    "hedged"
                  ]
                },
                "turn_id": {
                  "pattern": "^T[0-9]{3}$",
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "strength",
                "turn_id",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "spans": {
            "items": {
              "pattern": "^T[0-9]{3}$",
              "type": "string"
            },
            "type": "array"
          },
          "strength": {
            "enum": [
              "firm",
              "hedged"
            ]
          }
        },
        "required": [
          "canonical_key",
          "category",
          "emphasis",
          "instruction_id",
          "priority_rank",
          "reversal_chain",
          "spans",
          "strength"
        ],
        "type": "object"
      },
      "type": "array"
    },
