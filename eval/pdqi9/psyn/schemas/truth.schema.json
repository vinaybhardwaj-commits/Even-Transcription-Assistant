              "additionalProperties": false,
              "properties": {
                "allowed_labels": {
                  "items": {
                    "enum": [
                      "supported",
                      "h_unattrib",
                      "unaligned",
                      "precedence_error",
                      "clip_leak",
                      "not_stated"
                    ]
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "context_turn_ids": {
                  "items": {
                    "pattern": "^T[0-9]{3}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "expected_in_note": {
                  "type": "boolean"
                },
                "forbidden_labels": {
                  "items": {
                    "enum": [
                      "supported",
                      "h_unattrib",
                      "unaligned",
                      "precedence_error",
                      "clip_leak",
                      "not_stated"
