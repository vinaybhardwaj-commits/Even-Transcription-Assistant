        "required": [
          "canonical_key",
          "concern_id",
          "turn_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "pdqi9": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "defect_code": {
              "anyOf": [
                {
                  "type": "null"
