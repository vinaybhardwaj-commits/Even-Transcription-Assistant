        "required": [
          "clip_region",
          "est_seconds",
          "intended_diar_label",
          "on_treating_label",
          "section_hint",
          "short_segment",
          "speaker_id",
          "true_identity",
          "true_role",
          "turn_id"
        ],
        "type": "object"
      },
      "type": "array"
