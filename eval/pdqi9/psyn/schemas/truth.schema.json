                    "type": "object"
                  },
                  "type": "array"
                },
                "ideal_label": {
                  "enum": [
                    "supported",
                    "h_unattrib",
                    "unaligned",
                    "precedence_error",
                    "clip_leak",
                    "not_stated"
                  ]
                },
                "invented_value_label": {
                  "enum": [
                    "supported",
                    "h_unattrib",
                    "unaligned",
                    "precedence_error",
                    "clip_leak",
                    "not_stated"
                  ]
                },
                "label_by_cited_source": {
                  "additionalProperties": {
                    "enum": [
                      "supported",
                      "h_unattrib",
                      "unaligned",
                      "precedence_error",
                      "clip_leak",
                      "not_stated"
                    ]
                  },
                  "propertyNames": {
                    "enum": [
                      "3of3",
                      "armc",
                      "both",
                      "none"
                    ]
                  },
                  "type": "object"
                },
                "name": {
                  "type": "string"
                },
                "placeholder_forbidden": {
                  "type": "boolean"
                },
                "relay_turn_ids": {
                  "items": {
                    "pattern": "^T[0-9]{3}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "said_by": {
                  "items": {
                    "pattern": "^S[0-9]+$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "said_by_roles": {
                  "items": {
                    "enum": [
                      "treating_doctor",
                      "other_clinician",
                      "staff",
                      "translator",
                      "patient",
                      "attender"
                    ]
