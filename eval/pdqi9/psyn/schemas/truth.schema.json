{
  "$id": "psyn/truth.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affect_scenes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agreement_design": {
            "type": "string"
          },
          "expected_arm4_effect": {
            "enum": [
              "none",
              "reorder_or_emphasis_only"
            ]
          },
          "intended_state": {
            "type": "string"
          },
          "new_items_allowed": {
            "const": 0
          },
          "scene_id": {
            "type": "string"
          },
          "speaker_id": {
            "pattern": "^S[0-9]+$",
            "type": "string"
          },
          "turn_ids": {
            "items": {
              "pattern": "^T[0-9]{3}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "agreement_design",
          "expected_arm4_effect",
          "intended_state",
          "new_items_allowed",
          "scene_id",
          "speaker_id",
          "turn_ids"
