                  "type": "array"
                },
                "segcheck_applies": {
                  "type": "boolean"
                },
                "segcheck_expected_fail": {
                  "enum": [
                    "duration",
                    "cosine_or_role",
                    null
                  ]
                },
                "surface": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "t28e_counted": {
                  "type": "boolean"
                },
                "turn_ids": {
                  "items": {
                    "pattern": "^T[0-9]{3}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "value",
                "surface",
                "turn_ids",
                "context_turn_ids",
                "relay_turn_ids",
                "forbidden_values",
                "said_by",
                "said_by_roles",
                "ideal_label",
                "allowed_labels",
                "forbidden_labels",
                "label_by_cited_source",
                "expected_in_note",
                "segcheck_applies",
                "t28e_counted",
                "placeholder_forbidden",
                "segcheck_expected_fail"
