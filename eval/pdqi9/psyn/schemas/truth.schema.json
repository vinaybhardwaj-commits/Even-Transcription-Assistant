              {
                "type": "null"
              }
            ]
          },
          "speaker_id": {
            "pattern": "^S[0-9]+$",
            "type": "string"
          },
          "true_role": {
            "enum": [
              "treating_doctor",
              "other_clinician",
              "staff",
              "translator",
              "patient",
              "attender"
            ]
          }
        },
        "required": [
          "intended_diar_label",
          "is_treating",
          "pseudo_doctor_id",
          "speaker_id",
          "true_role"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "script_id": {
      "pattern": "^PSYN-(SE|SN|SC|SR|SD|SA|SV|SM)-[0-9]{3}$",
      "type": "string"
