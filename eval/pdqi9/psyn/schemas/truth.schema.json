                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "defect_in": {
              "enum": [
                "consult",
                "twin",
                null
              ]
            },
            "off_target": {
              "const": "clean_baseline"
            },
            "planted_level": {
              "enum": [
                1,
                3,
                5
              ]
            },
            "rubric": {
              "enum": [
                "pdqi9-encounter",
                "pdqi9-note@2",
                "all"
              ]
            },
            "target_item": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "defect_code",
            "defect_in",
            "off_target",
            "planted_level",
            "rubric",
            "target_item"
          ],
          "type": "object"
        }
      ]
