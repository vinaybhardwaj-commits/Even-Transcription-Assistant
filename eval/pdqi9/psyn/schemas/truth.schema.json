                "forbidden_values": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "enum": [
                          "supported",
                          "h_unattrib",
                          "unaligned",
                          "precedence_error",
                          "clip_leak",
                          "not_stated"
                        ]
                      },
                      "turn_ids": {
                        "items": {
                          "pattern": "^T[0-9]{3}$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "turn_ids",
                      "value"
