            "minItems": 1,
            "type": "array"
          },
          "canonical_key": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "emphasis": {
            "additionalProperties": false,
            "properties": {
              "repeat_count": {
                "minimum": 1,
                "type": "integer"
              },
              "stressed": {
                "type": "boolean"
              }
            },
            "required": [
              "repeat_count",
              "stressed"
            ],
            "type": "object"
          },
          "expected_in_note": {
            "type": "boolean"
          },
          "is_order": {
            "type": "boolean"
          },
          "item_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "medicine",
              "investigation",
              "referral",
              "procedure",
              "other_order",
              "diagnosis",
              "advice",
              "counselling",
              "warning",
              "lifestyle",
              "follow_up",
              "contingency",
              "patient_concern"
            ]
          },
          "pdqi_defect": {
            "type": "boolean"
          },
          "priority_rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "reversal_chain": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "enum": [
                    "firm",
                    "hedged"
                  ]
                },
                "turn_id": {
                  "pattern": "^T[0-9]{3}$",
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "strength",
                "turn_id",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "said_by_roles": {
            "items": {
              "enum": [
                "treating_doctor",
                "other_clinician",
                "staff",
                "translator",
                "patient",
                "attender"
              ]
            },
            "type": "array"
          },
          "strength": {
            "enum": [
              "firm",
              "hedged"
            ]
          },
          "trap": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "affirmed_patient_raised",
          "attributes",
          "canonical_key",
          "category",
          "emphasis",
          "expected_in_note",
          "is_order",
          "item_id",
          "kind",
          "pdqi_defect",
          "priority_rank",
          "reversal_chain",
          "said_by_roles",
          "strength",
          "trap"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "language_mode": {
      "enum": [
        "en",
        "cs"
      ]
    },
    "oracle_ablation": {
      "const": [
        "script_text",
        "pipeline_transcript"
      ]
    },
    "patient_concerns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_key": {
            "type": "string"
