        "type": "object"
      },
      "type": "array"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_key": {
            "type": "string"
          },
          "claim_id": {
            "type": "string"
          },
          "item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "present",
              "decoy"
            ]
          }
        },
        "required": [
          "canonical_key",
          "claim_id",
          "item_id",
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "decoy_list": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "decoy_share": {
      "type": "number"
    },
    "generator_version": {
      "type": "string"
    },
    "instructions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_key": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "emphasis": {
            "additionalProperties": false,
            "properties": {
              "repeat_count": {
                "minimum": 1,
                "type": "integer"
              },
              "stressed": {
                "type": "boolean"
              }
            },
            "required": [
              "repeat_count",
              "stressed"
            ],
            "type": "object"
          },
          "instruction_id": {
            "type": "string"
          },
          "priority_rank": {
            "type": [
              "integer",
              "null"
            ]
