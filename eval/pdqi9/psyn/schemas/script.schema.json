{
  "$id": "psyn/script.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affect_scenes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "agreement_design": {
            "type": "string"
          },
          "expected_arm4_effect": {
            "enum": [
              "none",
              "reorder_or_emphasis_only"
            ]
          },
          "intended_state": {
            "type": "string"
          },
          "new_items_allowed": {
            "const": 0
          },
          "scene_id": {
            "type": "string"
          },
          "speaker_id": {
            "pattern": "^S[0-9]+$",
            "type": "string"
          },
          "turn_ids": {
            "items": {
              "pattern": "^T[0-9]{3}$",
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "agreement_design",
          "expected_arm4_effect",
          "intended_state",
          "new_items_allowed",
          "scene_id",
          "speaker_id",
          "turn_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "claims": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "canonical_key": {
            "type": "string"
          },
          "claim_id": {
            "pattern": "^C[0-9]{2}$",
            "type": "string"
          },
          "item_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "enum": [
              "present",
              "decoy"
            ]
          },
          "probe": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "canonical_key",
          "claim_id",
          "item_id",
          "kind",
          "probe",
          "text"
        ],
        "type": "object"
      },
      "minItems": 4,
      "type": "array"
    },
    "codeswitch_lang": {
      "enum": [
        "hi",
        "kn",
        null
      ]
    },
    "language_mode": {
      "enum": [
        "en",
        "cs"
      ]
    },
    "metadata_variants": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "enrolled_pseudo_doctor_ids": {
            "items": {
              "pattern": "^PD[0-9]{2}$",
              "type": "string"
            },
            "type": "array"
          },
          "logged_in_pseudo_doctor_id": {
            "anyOf": [
              {
                "pattern": "^PD[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "login_coverage": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "end_frac": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  },
                  "start_frac": {
                    "maximum": 1,
                    "minimum": 0,
                    "type": "number"
                  }
                },
                "required": [
                  "start_frac",
                  "end_frac"
                ],
                "type": "object"
              }
            ]
          },
          "variant_id": {
            "enum": [
              "v1",
              "v2",
              "v3",
              "v4",
              "v5"
            ]
          }
        },
        "required": [
          "description",
          "enrolled_pseudo_doctor_ids",
          "logged_in_pseudo_doctor_id",
          "login_coverage",
          "variant_id"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "notes": {
      "type": "object"
    },
    "pdqi9_plan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "additionalProperties": false,
          "properties": {
            "defect_code": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            },
            "defect_in": {
              "enum": [
                "consult",
                "twin",
                null
              ]
            },
            "off_target": {
              "const": "clean_baseline"
            },
            "planted_level": {
              "enum": [
                1,
                3,
                5
              ]
            },
            "rubric": {
              "enum": [
                "pdqi9-encounter",
                "pdqi9-note@2",
                "all"
              ]
            },
            "target_item": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "defect_code",
            "defect_in",
            "off_target",
            "planted_level",
            "rubric",
            "target_item"
          ],
          "type": "object"
        }
      ]
    },
    "planted_items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affirmed_patient_raised": {
            "type": "boolean"
          },
          "attributes": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "context_turn_ids": {
                  "items": {
                    "pattern": "^T[0-9]{3}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "forbidden_values": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "label": {
                        "enum": [
                          "supported",
                          "h_unattrib",
                          "unaligned",
                          "precedence_error",
                          "clip_leak",
                          "not_stated"
                        ]
                      },
                      "turn_ids": {
                        "items": {
                          "pattern": "^T[0-9]{3}$",
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "label",
                      "turn_ids",
                      "value"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "relay_turn_ids": {
                  "items": {
                    "pattern": "^T[0-9]{3}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "surface": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "turn_ids": {
                  "items": {
                    "pattern": "^T[0-9]{3}$",
                    "type": "string"
                  },
                  "type": "array"
                },
                "value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "context_turn_ids",
                "forbidden_values",
                "name",
                "relay_turn_ids",
                "surface",
                "turn_ids",
                "value"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "canonical_key": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "emphasis": {
            "additionalProperties": false,
            "properties": {
              "repeat_count": {
                "minimum": 1,
                "type": "integer"
              },
              "stressed": {
                "type": "boolean"
              }
            },
            "required": [
              "repeat_count",
              "stressed"
            ],
            "type": "object"
          },
          "is_order": {
            "type": "boolean"
          },
          "item_id": {
            "pattern": "^I[0-9]{2}$",
            "type": "string"
          },
          "kind": {
            "enum": [
              "medicine",
              "investigation",
              "referral",
              "procedure",
              "other_order",
              "diagnosis",
              "advice",
              "counselling",
              "warning",
              "lifestyle",
              "follow_up",
              "contingency",
              "patient_concern"
            ]
          },
          "pdqi_defect": {
            "type": "boolean"
          },
          "priority_rank": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stances": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "strength": {
                  "enum": [
                    "firm",
                    "hedged"
                  ]
                },
                "turn_id": {
                  "pattern": "^T[0-9]{3}$",
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "strength",
                "turn_id",
                "value"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "strength": {
            "enum": [
              "firm",
              "hedged"
            ]
          },
          "trap": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "affirmed_patient_raised",
          "attributes",
          "canonical_key",
          "category",
          "emphasis",
          "is_order",
          "item_id",
          "kind",
          "pdqi_defect",
          "priority_rank",
          "stances",
          "strength",
          "trap"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "relays": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "adds_content": {
            "type": "boolean"
          },
          "changed_attribute": {
            "type": [
              "string",
              "null"
            ]
          },
          "changes_value": {
            "type": "boolean"
          },
          "doctor_value": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected_event": {
            "enum": [
              "relay",
              "relay_conflict",
              "translator_added"
            ]
          },
          "item_id": {
            "type": "string"
          },
          "of_turn_id": {
            "pattern": "^T[0-9]{3}$",
            "type": "string"
          },
          "relay_turn_id": {
            "pattern": "^T[0-9]{3}$",
            "type": "string"
          },
          "relay_value": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "adds_content",
          "changed_attribute",
          "changes_value",
          "doctor_value",
          "expected_event",
          "item_id",
          "of_turn_id",
          "relay_turn_id",
          "relay_value"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "scenario": {
      "type": "string"
    },
    "script_id": {
      "pattern": "^PSYN-(SE|SN|SC|SR|SD|SA|SV|SM)-[0-9]{3}$",
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "speakers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "display_name": {
            "type": "string"
          },
          "enrolment": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "utterance_id": {
                      "pattern": "^PD[0-9]{2}-E[0-9]{2}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "text",
                    "utterance_id"
                  ],
                  "type": "object"
                },
                "type": "array"
              }
            ]
          },
          "intended_diar_label": {
            "pattern": "^L[0-9]+$",
            "type": "string"
          },
          "is_treating": {
            "type": "boolean"
          },
          "language": {
            "enum": [
              "en",
              "hi",
              "kn"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "pseudo_doctor_id": {
            "anyOf": [
              {
                "pattern": "^PD[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "treating_doctor",
              "other_clinician",
              "staff",
              "translator",
              "patient",
              "attender"
            ]
          },
          "speaker_id": {
            "pattern": "^S[0-9]+$",
            "type": "string"
          },
          "voice_alike_of": {
            "anyOf": [
              {
                "pattern": "^PD[0-9]{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "voice_ref": {
            "type": "string"
          }
        },
        "required": [
          "display_name",
          "enrolment",
          "intended_diar_label",
          "is_treating",
          "language",
          "note",
          "pseudo_doctor_id",
          "role",
          "speaker_id",
          "voice_alike_of",
          "voice_ref"
        ],
        "type": "object"
      },
      "minItems": 2,
      "type": "array"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "split_cell": {
      "type": "string"
    },
    "split_group": {
      "type": "string"
    },
    "stratum": {
      "enum": [
        "S-E",
        "S-N",
        "S-C",
        "S-R",
        "S-D",
        "S-A",
        "S-V",
        "S-M"
      ]
    },
    "synthetic": {
      "const": true
    },
    "trap_tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "treating_speaker_id": {
      "pattern": "^S[0-9]+$",
      "type": "string"
    },
    "turns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "affect": {
            "type": [
              "string",
              "null"
            ]
          },
          "clip_region": {
            "enum": [
              "in_clip",
              "pre_bleed",
              "post_bleed"
            ]
          },
          "est_seconds": {
            "exclusiveMinimum": 0,
            "type": "number"
          },
          "intended_diar_label": {
            "pattern": "^L[0-9]+$",
            "type": "string"
          },
          "lang": {
            "enum": [
              "en",
              "hi",
              "kn"
            ]
          },
          "overlap_with": {
            "anyOf": [
              {
                "pattern": "^T[0-9]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "relay_of": {
            "anyOf": [
              {
                "pattern": "^T[0-9]{3}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "section_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "short_segment": {
            "type": "boolean"
          },
          "speaker_id": {
            "pattern": "^S[0-9]+$",
            "type": "string"
          },
          "text": {
            "minLength": 1,
            "type": "string"
          },
          "turn_id": {
            "pattern": "^T[0-9]{3}$",
            "type": "string"
          }
        },
        "required": [
          "affect",
          "clip_region",
          "est_seconds",
          "intended_diar_label",
          "lang",
          "overlap_with",
          "relay_of",
          "section_hint",
          "short_segment",
          "speaker_id",
          "text",
          "turn_id"
        ],
        "type": "object"
      },
      "minItems": 5,
      "type": "array"
    }
  },
  "required": [
    "affect_scenes",
    "claims",
    "codeswitch_lang",
    "language_mode",
    "metadata_variants",
    "notes",
    "pdqi9_plan",
    "planted_items",
    "relays",
    "scenario",
    "script_id",
    "seed",
    "speakers",
    "split",
    "split_cell",
    "split_group",
    "stratum",
    "synthetic",
    "trap_tags",
    "treating_speaker_id",
    "turns"
  ],
  "title": "P-SYN scripted consult",
  "type": "object"
}
