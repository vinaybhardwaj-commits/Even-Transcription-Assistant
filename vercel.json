{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/admin/reap-stuck",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/admin/resume-processing",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/admin/measure-windows",
      "schedule": "30 20 * * *"
    },
    {
      "path": "/api/admin/diarize-windows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/nemotron-identity",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/pulse-doctor-voice",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/admin/emotion-windows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/drain-windows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/admin/join-windows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/jobs/run",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/room-watchdog",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/admin/bench/levels-retention",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron/encounter-windows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/encounter-windows/sweep",
      "schedule": "7 * * * *"
    },
    {
      "path": "/api/cron/encounter-windows/warehouse",
      "schedule": "*/2 * * * *"
    },
    {
      "path": "/api/cron/kiosk-health-retention",
      "schedule": "35 21 * * *"
    },
    {
      "path": "/api/cron/steward",
      "schedule": "* * * * *"
    }
  ],
  "headers": [
    {
      "source": "/ext/update.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/ext/:file(.*).crx",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-chrome-extension"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ]
}
