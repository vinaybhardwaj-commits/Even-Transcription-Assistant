<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.eta.presence-poller</string>
  <key>ProgramArguments</key><array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-m</string><string>poller.main</string>
  </array>
  <key>WorkingDirectory</key><string>/path/to/eta-presence-poller</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/path/to/data/presence/poller.log</string>
  <key>StandardErrorPath</key><string>/path/to/data/presence/poller.log</string>
</dict></plist>
