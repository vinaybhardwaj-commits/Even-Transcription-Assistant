      "est_seconds": 4.6,
      "intended_diar_label": "L0",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Dekhiye, so this has been going on since yesterday morning, theek hai?",
      "turn_id": "T011"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 2.7,
      "intended_diar_label": "L0",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Dekhiye, let me examine you, theek hai?",
      "turn_id": "T012"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 6.2,
      "intended_diar_label": "L0",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": "exam",
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Dekhiye, both eyes are red with sticky discharge, vision is normal, cornea is clear, theek hai?",
      "turn_id": "T013"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 8.1,
      "intended_diar_label": "L0",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Dekhiye, I think this is infective conjunctivitis, because both eyes are sticky with normal vision and a clear cornea, theek hai?",
      "turn_id": "T014"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 8.5,
      "intended_diar_label": "L0",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Moxifloxacin eye drops 0.5 percent lijiye, ek boond dono aankh mein, din mein teen baar, paanch din tak, haath dhone ke baad.",
      "turn_id": "T015"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 6.9,
      "intended_diar_label": "L0",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Levocetirizine 5 mg lijiye, ek goli muh se, raat ko ek baar, teen din tak, khane ke baad.",
      "turn_id": "T016"
    },
    {
      "affect": null,
