      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Any allergy to medicines, bataiye?",
      "turn_id": "T009"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 1.5,
      "intended_diar_label": "L1",
      "lang": "hi",
      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S2",
      "text": "Nahi, aisa kuch nahi.",
