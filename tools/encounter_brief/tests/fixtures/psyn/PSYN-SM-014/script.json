      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S3",
      "text": "Kya oral rehydration salts standard sachet bhi le sakte hain, ek sachet?",
      "turn_id": "T017"
