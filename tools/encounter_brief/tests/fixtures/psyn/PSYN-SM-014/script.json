      "overlap_with": null,
      "relay_of": null,
      "section_hint": "complaint",
      "short_segment": false,
      "speaker_id": "S2",
      "text": "Dono aankhein laal aur chipchipi hain.",
      "turn_id": "T002"
    },
    {
      "affect": null,
      "clip_region": "in_clip",
      "est_seconds": 2.7,
      "intended_diar_label": "L0",
