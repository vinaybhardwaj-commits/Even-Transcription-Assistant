      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Paracetamol 500 mg lijiye, ek goli muh se, din mein teen baar, teen din tak, khane ke baad.",
