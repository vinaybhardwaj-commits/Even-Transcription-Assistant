      "overlap_with": null,
      "relay_of": null,
      "section_hint": null,
      "short_segment": false,
      "speaker_id": "S1",
      "text": "Dekhiye, I think this is a viral upper respiratory infection, because it started with a running nose, the chest is clear and there is no breathing trouble, theek hai?",
