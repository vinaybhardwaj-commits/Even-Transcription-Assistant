# /etc/systemd/system/timbre-nightly.service — Timbre nightly job (Architecture #79). Off unless the config or
# TIMBRE_NIGHTLY_ENABLED=1 turns it on. Secrets live in /etc/timbre-nightly.env (mode 0600), never in this file.
[Unit]
Description=Timbre nightly patient-voice affect scoring (#79)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=eta
WorkingDirectory=/home/eta/timbre-nightly/code
EnvironmentFile=/etc/timbre-nightly.env
ExecStart=/home/eta/timbre-nightly/venv/bin/python -m tools.timbre.nightly run --config /etc/timbre-nightly.json
TimeoutStartSec=8h
Nice=10
