<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.evenscribe.room-guardian</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-p</string>
    <string>__GUARDIAN_HOME__/bin/guardian.sh</string>
    <string>run</string>
  </array>
  <!-- R12: bash -p ignores BASH_ENV, SHELLOPTS and exported functions. guardian.sh run reads only GUARDIAN_HOME (and HOME, RR_*) from this environment:
       a test seam or tunable set here (GUARDIAN_TESTMODE, GUARDIAN_FAKE_NOW, CONTROL_STALE_S ...) is ignored. The safety numbers are constants in code. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>GUARDIAN_HOME</key><string>__GUARDIAN_HOME__</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>__GUARDIAN_HOME__/guardian.out</string>
  <key>StandardErrorPath</key><string>__GUARDIAN_HOME__/guardian.err</string>
</dict>
</plist>
