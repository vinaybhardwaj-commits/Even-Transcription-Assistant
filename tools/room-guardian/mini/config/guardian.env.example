# Copy to ~/oc/fleet-access/guardian/guardian.env (mode 0600). Placeholders only; real values never go in git.
GUARDIAN_HOME=$HOME/oc/fleet-access/guardian
PIPE_HOST=<tailnet-address-of-the-mini>        # from config, never hard-coded in the repo
PIPE_SSH_PORT=<non-22 port, e.g. 2225>
PIPE_PROM_PORT=<second listener port>
PIPE_DATABASE_URL_FILE=$GUARDIAN_HOME/pipe-database-url   # one line, mode 0600; the URL is exported as DATABASE_URL, never put in argv
PIPE_WORKDIR=$GUARDIAN_HOME/pipe                          # holds ssh_data/term_info_ed25519 (host key, 0600)
PIPE_BIN=$GUARDIAN_HOME/bin/pipe-ssh
