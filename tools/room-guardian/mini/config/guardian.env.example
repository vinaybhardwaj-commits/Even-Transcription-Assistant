# Copy to ~/oc/fleet-access/guardian/etc/guardian.env (mode 0600). Placeholders and paths only; real values never go in git (G7).
GUARDIAN_HOME=$HOME/oc/fleet-access/guardian
# The tailnet address is NOT configured: scripts/run-pipe.sh reads `tailscale ip -4` at every start and refuses to bind anything else.
PIPE_SSH_PORT=<non-22 port>
PIPE_PROM_PORT=                                  # EMPTY = prometheus listener off. Never set it: pico would bind it on the tailnet address.
PIPE_DATABASE_URL_FILE=$GUARDIAN_HOME/etc/pipe-database-url   # one line, mode 0600, exported as DATABASE_URL, never on argv
PIPE_WORKDIR=$GUARDIAN_HOME/pipe                 # holds ssh_data/term_info_ed25519 (host key, 0600)
PIPE_BIN=$GUARDIAN_HOME/bin/pipe-ssh
KILL_SWITCH_FILE=$GUARDIAN_HOME/etc/kill-switch  # "off" = actions allowed; anything else or missing = KILLED
# PICO_PIPE_ENABLED must stay false (run-pipe.sh refuses to start otherwise): pico defaults to shipping its logs to the hosted pico.sh.
