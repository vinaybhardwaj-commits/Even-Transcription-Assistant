 "id_keys": [
  "consult_key",
  "consult_uid",
  "hypothesis_id",
  "acoustic_key",
  "room_day_id",
  "shadow_id",
  "run_id",
  "pqm_step_uid",
  "window_id",
  "pulse_enc_id"
 ],
 "formats": {
  "consult_uid": "^(?:pqm_[0-9a-f]{22}|(?!.*[0-9]{7})[a-z0-9]{20,32})$",
  "consult_key": "^(?!.*[0-9]{7})[a-z0-9]{20,32}@[A-Za-z0-9][A-Za-z0-9._-]{0,62}$",
  "pqm_step_uid": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[0-9a-f]{16,64})$",
  "window_id": "^(?:bw_[a-hjkmnp-z2-9]{8}_[0-9]{13}_(?:primary|backup)|[0-9]{1,7}|1[0-2][0-9]{14})$",
  "room_id": "^room_[a-hjkmnp-z2-9]{8}$",
  "room_day_id": "^rd_[a-hjkmnp-z2-9]{8}$",
  "hypothesis_id": "^eh_[a-hjkmnp-z2-9]{12}$",
  "acoustic_key": "^rd_[a-hjkmnp-z2-9]{8}:[0-9a-z]{4,6}$",
  "run_id": "^(?:ehr_[a-hjkmnp-z2-9]{12}|ets_[0-9a-f]{18})$",
  "shadow_id": "^et_[0-9a-f]{18}$",
  "pulse_enc_id": "^(?!.*[0-9]{7})[A-Za-z0-9_-]{8,64}$"
 },
 "source_key_format": {
  "pulse": "consult_key",
  "timeline": "consult_key",
  "acoustic": "acoustic_key",
  "pqm": "consult_uid",
  "cutter": "consult_uid",
  "caa": "consult_uid",
  "nemotron_window": "window_id"
 },
 "id_key_proxies": {
  "pulse_enc_id": [
   "pulse",
   "pqm"
  ]
 }
}
