# =============================================================================
# Even Transcription Assistant (Evenscribe) — environment variables
# =============================================================================
# Copy to .env.local for local dev (NEVER commit real values).
# Production values live in Vercel env (Sensitive type), region bom1.
# This file lists EVERY variable the code reads (grep process.env). Values shown
# are placeholders/defaults only.
# =============================================================================

# --- Databases (Neon Postgres, accessed via the serverless HTTP driver) -------
# APP DB — encounters/clinicians/notes/sends/traces/voiceprints/STT-lab.
DATABASE_URL=
APP_DATABASE_URL=
APP_DATABASE_URL_UNPOOLED=
# KB DB — read-only pgvector knowledge base (shared with sibling apps).
KB_DATABASE_URL=

# --- Auth (jose JWT HS256; two audiences) ------------------------------------
JWT_SECRET_DOCTOR=          # signs doctor PIN sessions (cookie rounds_session)
JWT_SECRET_ADMIN=           # signs admin sessions (cookie eta_admin_session, Path=/)

# --- Admin gate ---------------------------------------------------------------
ADMIN_BASE_PATH=            # 32-char URL-safe random; obscured admin URL prefix
ADMIN_TOKEN=                # bearer for privileged admin bootstrap routes
ADMIN_PASSWORD_CURRENT=     # shared admin password (migrate to per-admin creds)

# --- Migration runner + cron --------------------------------------------------
MIGRATION_SECRET=           # bearer for POST /api/run-migrations and reap-stuck
CRON_SECRET=                # optional; defense-in-depth for the Vercel cron (x-vercel-cron is the primary auth)

# --- LLM (self-hosted Ollama, OpenAI-compatible; Mac-Mini tunnel) -------------
OLLAMA_BASE_URL=            # e.g. https://<tunnel>/v1  (NOTE: include /v1)
LLM_BASE_URL=               # optional override; falls back to OLLAMA_BASE_URL
LLM_API_KEY=                # optional; "ollama" if unset
# Per-stage model overrides (all optional; sensible defaults in code):
NOTE_MODEL=                 # note generation (default qwen2.5:14b)
CDS_MODEL=
CDS_DRAFT_MODEL=
CDS_CRITIQUE_MODEL=
CDS_REVISE_MODEL=
HYDE_MODEL=
CLEANUP_MODEL=
TEXT_MODEL=
EMBED_MODEL=                # embeddings for KB retrieval (default nomic-embed-text)
TOP_K=                      # KB retrieval depth

# --- LLM routing: Vertex AI Gemini (lib/llm/gemini.ts) ------------------------
# OFF by default. With GCP_SA_KEY or GCP_PROJECT unset, geminiConfigured() is false and
# EVERY surface routes to Ollama exactly as before. Turning it on needs BOTH the Vertex
# credentials below AND a flag. routedChat() always soft-fails back to Ollama, which is
# why a misconfiguration is silent — use the MCP tool scribe_llm_health to see which
# provider is actually serving each surface.
GCP_SA_KEY=                 # SECRET. GCP service-account JSON (Vertex AI User). Never commit a real one.
GCP_PROJECT=                # GCP project id hosting the Vertex endpoint
GCP_LOCATION=               # Vertex region; default asia-south1 (use "global" for the global endpoint)
GEMINI_MODEL=               # "pro" tier model (default gemini-2.5-pro)
GEMINI_FLASH_MODEL=         # "flash" tier model (default gemini-2.5-flash)
# Per-surface flags — set to exactly "1" to route that surface to Gemini. GEMINI_ALL turns
# on all six at once; the per-surface flags are independent of it, not overrides.
GEMINI_ALL=                 # 1 = every surface below
GEMINI_NOTE=                # 1 = note generation (flash)          lib/note-generation.ts
GEMINI_CDS=                 # 1 = CDS draft/critique/revise (pro)   lib/cdmss-pipeline.ts
GEMINI_NATIVE=              # 1 = native-language analysis (flash)  lib/stt/indic-comprehension.ts
GEMINI_FUSION=              # 1 = multi-engine transcript fusion (pro) lib/stt/fuse-transcript.ts
GEMINI_LIVE=                # 1 = live translate (flash)            app/[slug]/api/translate-live
GEMINI_NOTEGEN_ANALYZE=     # 1 = notegen analyze (flash)           app/[slug]/api/notegen/analyze
TRANSCRIPT_FUSION=          # 1 = enable the multi-engine fusion pass at all (gates the fusion surface)

# --- Transcription / ASR ------------------------------------------------------
DEEPGRAM_API_KEY=           # live English WebSocket transcription
DEEPGRAM_PROJECT_ID=
WHISPER_BASE_URL=           # Mac-Mini Whisper ASR (rolling medical-term accuracy)
INDICCONFORMER_BASE_URL=    # AI4Bharat IndicConformer Indic ASR (Mac-Mini Pattern B; e.g. https://indic.llmvinayminihome.uk)
INDICCONFORMER_DECODING=    # rnnt (default, accurate) | ctc (faster)
ETA_NOTE_PARALLEL_INDIC=    # 1 = submit-time pick-best (Sarvam vs IndicConformer) for the Indic note; OFF by default

# --- Window measurement (Build 1, nightly /api/admin/measure-windows) ---------
# UNSET IS THE INTENDED STATE. The job runs with its documented default; these exist so the
# orchestrator can retune after the first coverage report without a deploy.
ROOM_ENERGY_FLOOR=          # peak_level (RMS 0..1) at or above which a chunk counts as energy, below it as silence. Unset = 0.004, i.e. the room recorder's own -48 dBFS VAD floor converted to amplitude. Out-of-range or non-numeric values are IGNORED, never honoured.
ETA_INDIC_COMPREHENSION=    # Indic comprehension layer: save native-language analysis + feed native transcript as note reference. ON by default; set 0 to disable.
NEXT_PUBLIC_ETA_BACKGROUND_PROCESSING= # Background CDS pipeline (submit -> next encounter; results in Library). ON by default; set 0 to disable (kill-switch).
SARVAM_API_KEY=             # Sarvam Saaras v3 (Indic transcribe + translate)
SARVAM_STT_MODEL=           # default saaras:v3
NEXT_PUBLIC_STT_RELAY_URL=  # wss://... Mac-Mini Sarvam streaming relay (client-visible)
STT_RELAY_URL=              # server-side relay URL (if used)
STT_RELAY_SECRET=           # HMAC token minted for the relay

# --- Gemini STT (Build 3; ships DARK — fanout_enabled=false, no routing repoint) ------------
# NO NEW SECRET. Reuses GCP_SA_KEY / GCP_PROJECT / GCP_LOCATION, already set and proven live.
GEMINI_STT=                 # kill-switch. Exactly "1" arms the adapter; unset = it refuses before any network call.
GEMINI_STT_MODEL=           # REQUIRED when GEMINI_STT=1. There is deliberately NO code default: a default would silently attribute every measurement to whatever model it named. Unset with the gate on is a loud config error.
GEMINI_STT_USD_PER_1K_INPUT_TOKENS=   # Vertex bills audio per token, not per minute. Unset = costUsd stays NULL (never estimated inside the adapter).
GEMINI_STT_USD_PER_1K_OUTPUT_TOKENS=  # as above, for output tokens.
GEMINI_STT_ALLOW_MIME=      # comma list overriding the accepted audio containers. Unset = wav,mp3,aiff,aac,ogg,flac (audio/webm is NOT accepted by Gemini; the drain sends webm, so the adapter refuses before spending — see the Build 3 report). Set this only from a real probe result.

# --- STT Engine Lab competitors ----------------------------------------------
ELEVENLABS_API_KEY=         # ElevenLabs Scribe v2 (ASR + showcased scribe engine)
ELEVENLABS_STT_MODEL=       # default scribe_v2
EKACARE_CLIENT_ID=          # eka.care OAuth client-credentials (engine DISABLED via migration 0026)
EKACARE_CLIENT_SECRET=
EKASCRIBE_MODEL=
EKASCRIBE_SCRIBE_TEMPLATE=
EKASCRIBE_SCRIBE_COMPANION_TEMPLATE=
STT_GOLD_EXTRACT_MODEL=     # medical-term extraction for gold WER scoring
OPENAI_API_KEY=             # optional; cloud term extraction (unset = use local qwen)

# --- Room speaker clusters (Build 4; ships DARK) ------------------------------
# The cron is scheduled every 5 minutes and is a clean no-op until the gate is on.
SPEAKER_CLUSTERS_ENABLED=   # exactly "1" arms the room diarize cron. Unset = no-op, no DB work.
SPEAKER_MATCH_THRESHOLD=    # cosine at or above which a room voice sample joins an existing cluster. NO DEFAULT ANYWHERE: this number decides how many people the system believes were in the room, and unset with the gate on is a loud refusal, never a guess. Freeze it from GET /api/admin/speaker-calibration. Do NOT borrow 0.78 (live identify) or 0.82 (passive capture) — both compare against an ENROLLED clinician centroid, a different question.

# --- Speaker diarization / voiceprint (Mac-Mini pyannote) ---------------------
DIARIZE_BASE_URL=           # https://... pyannote diarize + enroll service
DIARIZE_TIMEOUT_MS=         # e.g. 90000
PASSIVE_VOICEPRINT_GATE=    # confidence to auto-retain a passive voice sample (e.g. 0.82)

# --- Audio storage (Cloudflare R2, S3-compatible) -----------------------------
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_BUCKET=                  # e.g. eta-audio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ADMIN_ACCESS_KEY_ID=     # separate key for admin audio download/CORS-fix
R2_ADMIN_SECRET_ACCESS_KEY=

# --- Joining service (U2: hear a consultation, not a piece) -------------------
# services/audio-join — Cloudflare Containers, deployed separately (D14). Joins the pieces a
# window crosses into one clip under clips/ in the SAME bucket. Both UNSET is a supported state:
# scribe_extract_audio then degrades to today's multi-piece answer (D10), never an error.
AUDIO_JOIN_URL=             # e.g. https://eta-audio-join.<subdomain>.workers.dev  (no trailing /join)
AUDIO_JOIN_TOKEN=           # shared bearer; same value as the Worker's JOIN_TOKEN secret

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=      # svix signing secret for delivery webhooks

# --- Live-path feature flags (client; default OFF = byte-identical prod) -------
NEXT_PUBLIC_ETA_TRIM_LIVE_BUFFERS=     # trim consumed live-transcription chunks
NEXT_PUBLIC_ETA_DEEPGRAM_RECONNECT=    # Deepgram live WS reconnect + token re-mint
NEXT_PUBLIC_ETA_SAFARI_STREAMING_GUARD=# extend the iOS worklet-skip to desktop Safari
NEXT_PUBLIC_ETA_INDIC_LIVE_BOX=        # ON by default (auto on non-English encounters). Set to 0 to kill-switch the 2nd native-script box.
NEXT_PUBLIC_ETA_LIVE_FLASH=            # live Gemini Flash translation in the kiosk (client-visible); needs GEMINI_LIVE server-side

# --- Ambient Brain (/api/brain/*, migrations 0042/0046/0047) -------------------
# Same Neon database as the app, a DIFFERENT role: lib/brain/db owns room_day / visit /
# speaker_cluster / cue, lib/db owns everything else. Both are needed.
BRAIN_DATABASE_URL=         # brain-role Postgres URL (room_day, visit, speaker_cluster, cue)
BRAIN_SERVICE_TOKEN=        # SECRET. Bearer for POST /api/brain/cues — the ONE cue write door.
# NOTE: there is no base-URL override any more. The standalone Cloud Run brain was deleted on
# 22 Aug 2026 and lib/brain, in this deployment, is the only brain. Cue writes always go to
# this app's own /api/brain/cues. Do not reintroduce a variable to point them elsewhere.

# --- Operator MCP (/api/mcp) --------------------------------------------------
SCRIBE_MCP_TOKEN=           # SECRET. Bearer for the MCP door; see lib/mcp/auth.ts for scope encoding.

# --- App ----------------------------------------------------------------------
APP_URL=                    # canonical app URL (https://www.evenscribe.app)

# --- Test/CI only (not needed at runtime) ------------------------------------
BASE_URL=                   # smoke.mjs target (default https://www.evenscribe.app)
EXPECT_SHA=                 # smoke: assert live build sha
SMOKE_DOCTOR_SLUG=          # smoke: assert a doctor PIN page renders
SMOKE_ADMIN_EMAIL=          # smoke: assert STT-lab engine health
SMOKE_ADMIN_PASSWORD=
PLAYWRIGHT_DOCTOR_SLUG=     # e2e
PLAYWRIGHT_DOCTOR_PIN=      # e2e (GitHub secret E2E_DOCTOR_PIN)
